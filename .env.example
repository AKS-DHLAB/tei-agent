# AI service: deepseek (default) | openai | anthropic | gemini
TEI_AGENT_PROVIDER=deepseek
# The key for the service you chose (only that one is read)
DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...     (Claude also needs: pip install anthropic)
# GEMINI_API_KEY=AIza...
# Optional overrides; each service has its own default model and URL
# TEI_AGENT_MODEL=deepseek-flash
# TEI_AGENT_BASE_URL=https://api.deepseek.com
