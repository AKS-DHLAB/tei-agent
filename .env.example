# DeepSeek API key (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-...
# Defaults (checked against api-docs.deepseek.com on 2026-10-12)
DEEPSEEK_BASE_URL=https://api.deepseek.com
TEI_AGENT_MODEL=deepseek-flash
# true = thinking mode (slower/costlier, sometimes better on hard texts)
TEI_AGENT_THINKING=false
TEI_AGENT_REASONING_EFFORT=high
# characters of source text per tagging request, and parallel requests
TEI_AGENT_CHUNK_CHARS=2500
TEI_AGENT_MAX_WORKERS=4
# language of explanations / questions in the UI
TEI_AGENT_UI_LANG=ko
